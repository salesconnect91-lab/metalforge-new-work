                  ["Purchase Orders / خرید آرڈر", metrics.purchaseOrders, "/purchase"],
                ]}
              />
              <QueueRow
                title="Operations / آپریشنز"
                rows={[
                  ["Warehouse Lines / گودام", metrics.warehouseLines, "/godown"],
                  ["Stock Movements / اسٹاک حرکت", metrics.stockMovements, "/godown"],
                  ["Work Orders / ورک آرڈر", metrics.workOrders, "/production"],
                  ["Cutting Orders / کٹنگ", metrics.cuttingOrders, "/cutting"],
