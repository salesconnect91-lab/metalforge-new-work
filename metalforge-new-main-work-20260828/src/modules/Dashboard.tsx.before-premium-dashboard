function QuickAction({
  label,
  link,
  icon,
  primary,
}: {
  label: string;
  link: string;
  icon: ReactNode;
  primary?: boolean;
}) {
  return (
    <Link
      to={link}
      className={`inline-flex h-9 items-center gap-2 rounded-full border px-4 text-xs font-semibold transition ${
        primary
          ? "border-emerald-700 bg-emerald-700 text-white shadow-sm hover:bg-emerald-800"
          : "border-slate-300 bg-white text-slate-700 hover:border-slate-400 hover:bg-slate-50"
      }`}
    >
      {icon}
      {label}
    </Link>
  );
}


function InlineKpi({
  label,
  value,
  detail,
  trend,
  tone,
}: {
  label: string;
  value: string;
  detail: string;
  trend?: number;
  tone: "emerald" | "blue" | "amber" | "violet" | "cyan" | "slate";
}) {
  const tones = {
    emerald: "border-t-emerald-500",
    blue: "border-t-blue-500",
    amber: "border-t-amber-500",
    violet: "border-t-violet-500",
    cyan: "border-t-cyan-500",
    slate: "border-t-slate-500",
  } as const;

  return (
    <div className={`rounded-xl border border-t-[3px] border-slate-200 bg-white px-4 py-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md ${tones[tone]}`}>
      <div className="text-[11px] font-bold uppercase tracking-wide text-slate-500">{label}</div>
      <div className="mt-2 text-lg font-bold tracking-tight text-slate-950">
        {value}
      </div>
      <div className="mt-1 flex items-center justify-between gap-2">
        <span className="text-xs text-slate-400">{detail}</span>
        {trend !== undefined && (
          <span
            className={`rounded-full px-2 py-0.5 text-[11px] font-bold ${
              trend >= 0 ? "bg-emerald-50 text-emerald-700" : "bg-red-50 text-red-700"
            }`}
          >
            {trend >= 0 ? "+" : ""}
            {trend}%
          </span>
        )}
      </div>
    </div>
  );
}

function Section({
  title,
  subtitle,
  icon,
  link,
  children,
}: {
  title: string;
  subtitle: string;
  icon: ReactNode;
  link?: string;
  children: ReactNode;
}) {
  return (
    <section className="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div className="flex items-center justify-between border-b border-slate-100 px-5 py-4">
        <div className="flex items-center gap-2.5">
          <span className="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-100 text-slate-600">{icon}</span>
          <div>
            <h2 className="text-base font-bold text-slate-900">{title}</h2>
            <p className="mt-0.5 text-xs text-slate-400">{subtitle}</p>
          </div>
        </div>
        {link && (
          <Link
            to={link}
            className="rounded-lg bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-700 hover:bg-blue-100"
          >
            Open →
          </Link>
        )}
      </div>
      {children}
    </section>
  );
}

function FinancialRow({
  label,
  value,
  icon,
  strong,
}: {
  label: string;
  value: number;
  icon: ReactNode;
  strong?: boolean;
}) {
  return (
    <div className="flex items-center justify-between px-4 py-3">
      <div className="flex items-center gap-3">
        <span className="text-slate-400">{icon}</span>
        <span
          className={`text-sm ${
            strong ? "font-semibold text-slate-800" : "text-slate-600"
          }`}
        >
          {label}
        </span>
      </div>
      <span
        className={`text-sm ${
          strong ? "font-bold text-slate-900" : "font-semibold text-slate-700"
        }`}
      >
        {compactMoney(value)}
      </span>
    </div>
  );
}

function QueueRow({
  title,
  rows,
}: {
  title: string;
  rows: [string, number, string][];
}) {
  return (
    <div className="p-4">
      <div className="mb-2 text-[11px] font-bold uppercase tracking-wider text-slate-400">
        {title}
      </div>
      <div className="divide-y divide-slate-100">
        {rows.map(([label, value, link]) => (
          <Link
            key={label}
            to={link}
            className="flex items-center justify-between rounded-lg px-2 py-2.5 text-sm transition hover:bg-slate-50"
          >
            <span className="text-slate-600">{label}</span>
            <span className="font-bold text-slate-900">{value.toLocaleString()}</span>
          </Link>
        ))}
      </div>
    </div>
  );
}

function RegisterRow({
  label,
  value,
  link,
  moneyValue,
  emphasis,
}: {
  label: string;
  value: number;
  link: string;
  moneyValue?: boolean;
  emphasis?: boolean;
}) {
  return (
    <tr className="border-b border-slate-100 last:border-0 hover:bg-slate-50">
      <td className="px-4 py-3 text-sm text-slate-600">{label}</td>
      <td
        className={`px-4 py-3 text-right text-sm ${
          emphasis ? "font-bold text-slate-900" : "font-semibold text-slate-800"
        }`}
      >
        {moneyValue ? compactMoney(value) : value.toLocaleString()}
      </td>
      <td className="w-8 px-2">
        <Link to={link} className="text-slate-400 hover:text-blue-700">
          <ChevronRight className="h-3.5 w-3.5" />
        </Link>
      </td>
    </tr>
  );
}

function QuickLink({
  label,
  link,
  icon,
}: {
  label: string;
  link: string;
  icon: ReactNode;
}) {
  return (
    <Link
      to={link}
      className="flex items-center gap-3 px-5 py-5 transition hover:bg-slate-50"
    >
      <span className="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-100 text-slate-600">{icon}</span>
      <span className="text-sm font-semibold text-slate-700">{label}</span>
    </Link>
  );
}
