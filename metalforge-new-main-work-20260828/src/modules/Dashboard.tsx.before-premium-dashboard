                  strong
                />
                <FinancialRow
                  label="Avg. Invoice / اوسط بل"
                  value={metrics.avgSaleValue}
                  icon={<FileText className="h-4 w-4" />}
                />
              </div>

              <div className="border-t border-slate-200 bg-slate-50 px-4 py-3">
                <div className="grid grid-cols-2 gap-4 text-xs">
                  <div>
                    <div className="uppercase tracking-wider text-slate-400">
                      YTD Revenue / سالانہ آمدنی
                    </div>
                    <div className="mt-1 text-sm font-bold text-slate-900">
                      {compactMoney(metrics.yearSalesTotal)}
                    </div>
                  </div>
                  <div>
                    <div className="uppercase tracking-wider text-slate-400">
                      Sales Growth / فروخت اضافہ
                    </div>
                    <div
                      className={`mt-1 flex items-center gap-1 text-sm font-bold ${
                        metrics.salesGrowth >= 0
                          ? "text-emerald-700"
                          : "text-red-700"
                      }`}
                    >
                      {metrics.salesGrowth >= 0 ? (
                        <ArrowUpRight className="h-3.5 w-3.5" />
                      ) : (
                        <ArrowDownRight className="h-3.5 w-3.5" />
                      )}
                      {metrics.salesGrowth}%
                    </div>
                  </div>
                </div>
              </div>
            </Section>
          </div>

          {/* Work queues */}
