} from "lucide-react";

interface OrderRow {
  id: string;
  total: number | string | null;
  created_at: string | null;
}

interface DashboardMetrics {
  items: number;
  customers: number;
  suppliers: number;
  salesOrders: number;
  purchaseOrders: number;
  workOrders: number;
  cuttingOrders: number;
  furnaceYields: number;
  warehouseLines: number;
  stockMovements: number;
  journalEntries: number;
  chartAccounts: number;
  salesTotal: number;
  purchaseTotal: number;
  monthSalesTotal: number;
  yearSalesTotal: number;
  monthPurchaseTotal: number;
  avgSaleValue: number;
  salesGrowth: number;
  purchaseGrowth: number;
}

interface DailyData {
  day: string;
  sales: number;
  purchases: number;
}

const initialMetrics: DashboardMetrics = {
  items: 0,
  customers: 0,
  suppliers: 0,
  salesOrders: 0,
  purchaseOrders: 0,
  workOrders: 0,
  cuttingOrders: 0,
  furnaceYields: 0,
  warehouseLines: 0,
  stockMovements: 0,
  journalEntries: 0,
  chartAccounts: 0,
  salesTotal: 0,
  purchaseTotal: 0,
  monthSalesTotal: 0,
  yearSalesTotal: 0,
  monthPurchaseTotal: 0,
  avgSaleValue: 0,
  salesGrowth: 0,
  purchaseGrowth: 0,
};

const money = (value: number) =>
  `PKR ${value.toLocaleString(undefined, {
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  })}`;

const compactMoney = (value: number) => {
  const n = Math.abs(value);
  if (n >= 10_000_000) return `PKR ${(value / 10_000_000).toFixed(2)} Cr`;
  if (n >= 100_000) return `PKR ${(value / 100_000).toFixed(2)} Lakh`;
  if (n >= 1_000_000) return `PKR ${(value / 1_000_000).toFixed(2)}M`;
  return money(value);
};

const num = (value: unknown) => {
  const n = Number(value);
  return Number.isFinite(n) ? n : 0;
};

function monthGrowth(rows: OrderRow[]) {
  const now = new Date();
  const month = now.getMonth();
  const year = now.getFullYear();
  const previousMonth = month === 0 ? 11 : month - 1;
  const previousYear = month === 0 ? year - 1 : year;

  let current = 0;
  let previous = 0;

  rows.forEach((row) => {
    if (!row.created_at) return;
    const d = new Date(row.created_at);
    const amount = num(row.total);

    if (d.getMonth() === month && d.getFullYear() === year) current += amount;
    if (
      d.getMonth() === previousMonth &&
      d.getFullYear() === previousYear
    ) {
      previous += amount;
    }
  });

  if (previous === 0) return current > 0 ? 100 : 0;
  return Number((((current - previous) / previous) * 100).toFixed(1));
}

export default function Dashboard() {
  const [metrics, setMetrics] = useState(initialMetrics);
  const [dailyData, setDailyData] = useState<DailyData[]>([]);
  const [userName, setUserName] = useState("Director");
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);

  const loadDashboard = async (refresh = false) => {
    if (refresh) setRefreshing(true);
    else setLoading(true);

    try {
      const safeCount = async (table: string) => {
        try {
          const { count, error } = await supabase
            .from(table)
            .select("*", { count: "exact", head: true });
          return error ? 0 : count ?? 0;
        } catch {
          return 0;
        }
      };

      const [
        items,
        customers,
        suppliers,
        workOrders,
        cuttingOrders,
        furnaceYields,
        warehouseLines,
        stockMovements,
        journalEntries,
        chartAccounts,
        salesResult,
        purchaseResult,
      ] = await Promise.all([
        safeCount("items"),
        safeCount("customers"),
        safeCount("suppliers"),
        safeCount("work_orders"),
        safeCount("cutting_orders"),
        safeCount("furnace_yields"),
        safeCount("warehouse_stock"),
        safeCount("stock_movements"),
        safeCount("journal_entries"),
        safeCount("chart_of_accounts"),
        supabase.from("sales_orders").select("id,total,created_at"),
        supabase.from("purchase_orders").select("id,total,created_at"),
      ]);

      const sales = (salesResult.data ?? []) as OrderRow[];
      const purchases = (purchaseResult.data ?? []) as OrderRow[];

      const now = new Date();
      const month = now.getMonth();
      const year = now.getFullYear();
      const dailyMap: Record<string, DailyData> = {};

      let salesTotal = 0;
      let purchaseTotal = 0;
      let monthSalesTotal = 0;
      let yearSalesTotal = 0;
      let monthPurchaseTotal = 0;

      sales.forEach((row) => {
        const amount = num(row.total);
        salesTotal += amount;
        if (!row.created_at) return;

        const d = new Date(row.created_at);
        if (d.getFullYear() === year) {
          yearSalesTotal += amount;
          if (d.getMonth() === month) {
            monthSalesTotal += amount;
            const key = String(d.getDate()).padStart(2, "0");
            dailyMap[key] ??= { day: key, sales: 0, purchases: 0 };
            dailyMap[key].sales += amount;
          }
        }
      });

      purchases.forEach((row) => {
        const amount = num(row.total);
        purchaseTotal += amount;
        if (!row.created_at) return;

        const d = new Date(row.created_at);
        if (d.getFullYear() === year && d.getMonth() === month) {
          monthPurchaseTotal += amount;
          const key = String(d.getDate()).padStart(2, "0");
          dailyMap[key] ??= { day: key, sales: 0, purchases: 0 };
          dailyMap[key].purchases += amount;
        }
      });

      const { data: authData } = await supabase.auth.getUser();
      const user = authData.user;
      if (user) {
        const rawName =
          user.user_metadata?.full_name ||
          user.user_metadata?.name ||
          user.email?.split("@")[0] ||
          "Operator";
        setUserName(
          String(rawName).charAt(0).toUpperCase() + String(rawName).slice(1)
        );
      }

      setMetrics({
        items,
        customers,
        suppliers,
        salesOrders: sales.length,
        purchaseOrders: purchases.length,
        workOrders,
        cuttingOrders,
        furnaceYields,
        warehouseLines,
        stockMovements,
        journalEntries,
        chartAccounts,
        salesTotal,
        purchaseTotal,
        monthSalesTotal,
        yearSalesTotal,
        monthPurchaseTotal,
        avgSaleValue: sales.length ? salesTotal / sales.length : 0,
        salesGrowth: monthGrowth(sales),
        purchaseGrowth: monthGrowth(purchases),
      });

      setDailyData(
        Object.values(dailyMap).sort((a, b) => Number(a.day) - Number(b.day))
      );
    } catch (error) {
      console.error("Dashboard load error:", error);
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  };

  useEffect(() => {
    void loadDashboard();
  }, []);

