    day: "2-digit",
    month: "short",
    year: "numeric",
  }).format(new Date());

  const monthName = new Intl.DateTimeFormat("en", {
    month: "long",
    year: "numeric",
  }).format(new Date());

  const maxDaily = useMemo(
    () =>
      Math.max(
        ...dailyData.map((item) => Math.max(item.sales, item.purchases)),
        1
      ),
    [dailyData]
  );


  return (
    <div className="min-h-full bg-[#f4f7f6] text-slate-800">


      <div className="w-full">

        <div className="w-full px-4 py-6 sm:px-6 lg:px-8">
          {/* Enterprise page header */}
          <div className="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div className="flex flex-col gap-5 px-5 py-5 md:flex-row md:items-center md:justify-between lg:px-7">
              <div>
                <div className="text-[11px] font-bold uppercase tracking-[0.2em] text-emerald-700">
                  Executive Control Center
                </div>
                <h1 className="mt-1 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
                  Good afternoon, {userName}!
                </h1>
                <p className="mt-1 text-sm text-slate-500">
                  Here is today’s financial and operational overview / آج کا کاروباری جائزہ
                </p>
                <div className="mt-2 flex items-center gap-2 text-xs text-slate-400">
                  <CalendarDays className="h-4 w-4" />
                  {today}
                </div>
              </div>

              <div className="flex flex-wrap items-center gap-3">
                <span className="flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-700">
                <span className="h-2 w-2 rounded-full bg-emerald-500" />
                System Online / سسٹم فعال
              </span>
              <button
                type="button"
                onClick={() => void loadDashboard(true)}
                  className="inline-flex h-10 items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"
              >
                <RefreshCw
                  className={refreshing ? "h-3 w-3 animate-spin" : "h-3 w-3"}
                />
                Refresh
              </button>
              </div>
            </div>

            <div className="border-t border-slate-100 bg-slate-50/70 px-5 py-4 lg:px-7">
              <div className="flex flex-wrap items-center gap-2">
                <span className="mr-1 text-xs font-bold text-slate-500">Quick actions</span>
                <QuickAction label="Create invoice" link="/sales/new" icon={<ShoppingCart className="h-4 w-4" />} primary />
                <QuickAction label="Sales invoices" link="/sales" icon={<FileText className="h-4 w-4" />} />
                <QuickAction label="Purchase order" link="/purchase" icon={<Truck className="h-4 w-4" />} />
                <QuickAction label="Record stock" link="/godown" icon={<Package className="h-4 w-4" />} />
                <QuickAction label="Journal entry" link="/accounting" icon={<BookOpen className="h-4 w-4" />} />
              </div>
            </div>
          </div>

          {/* Inline KPI ledger */}
          <section className="mt-5 overflow-x-auto">
