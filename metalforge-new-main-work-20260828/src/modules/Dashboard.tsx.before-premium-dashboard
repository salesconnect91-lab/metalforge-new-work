              <QuickLink label="Sales Invoice / فروخت بل" link="/sales" icon={<ShoppingCart className="h-4 w-4" />} />
              <QuickLink label="Purchase Order / خرید آرڈر" link="/purchase" icon={<Truck className="h-4 w-4" />} />
              <QuickLink label="Stock / اسٹاک" link="/godown" icon={<Package className="h-4 w-4" />} />
