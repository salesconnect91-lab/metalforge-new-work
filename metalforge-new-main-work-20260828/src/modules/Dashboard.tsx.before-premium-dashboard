                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {loading ? (
                      <tr>
                        <td
                          colSpan={5}
                          className="px-4 py-12 text-center text-sm text-slate-400"
                        >
                          Loading live transactions...
                        </td>
                      </tr>
                    ) : dailyData.length === 0 ? (
                      <tr>
                        <td
                          colSpan={5}
                          className="px-4 py-12 text-center text-sm text-slate-400"
                        >
                          No transaction activity for this month.
                        </td>
                      </tr>
                    ) : (
                      dailyData.map((row) => {
                        const net = row.sales - row.purchases;
                        const width = `${Math.max(
                          3,
                          Math.round((Math.max(row.sales, row.purchases) / maxDaily) * 100)
                        )}%`;

                        return (
                          <tr
                            key={row.day}
                            className="border-b border-slate-100 last:border-0 hover:bg-slate-50"
                          >
                            <td className="px-4 py-3 text-xs font-semibold text-slate-700">
                              {row.day} {new Intl.DateTimeFormat("en", { month: "short" }).format(new Date())}
                            </td>
                            <td className="px-4 py-3 text-right text-xs font-semibold text-slate-800">
                              {money(row.sales)}
                            </td>
                            <td className="px-4 py-3 text-right text-xs font-semibold text-slate-800">
                              {money(row.purchases)}
                            </td>
                            <td
                              className={`px-4 py-3 text-right text-xs font-semibold ${
                                net >= 0 ? "text-emerald-700" : "text-red-700"
                              }`}
                            >
                              {net >= 0 ? "+" : ""}
                              {money(net)}
                            </td>
                            <td className="px-4 py-2.5">
                              <div className="h-1.5 w-full bg-slate-100">
                                <div
                                  className="h-1.5 bg-blue-600"
                                  style={{ width }}
                                />
                              </div>
                            </td>
                          </tr>
                        );
                      })
                    )}
                  </tbody>
                </table>
              </div>
            </Section>

            <Section
              title="Financial Control / مالی کنٹرول"
              subtitle="Management overview / انتظامی جائزہ"
              icon={<Landmark className="h-4 w-4" />}
              link="/accounting"
