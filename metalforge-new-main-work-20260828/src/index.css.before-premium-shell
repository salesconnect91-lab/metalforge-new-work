@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html {
    @apply bg-[#f6f7f9];
  }

  body {
    @apply bg-[#f6f7f9] font-sans text-slate-900 antialiased;
    font-size: 12.5px;
    line-height: 1.4;
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
  }

  *::-webkit-scrollbar {
    width: 7px;
    height: 7px;
  }

  *::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 9999px;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  table {
    font-variant-numeric: tabular-nums;
  }
}

@layer components {
  .btn {
    @apply inline-flex h-8 items-center justify-center gap-1.5 rounded-md px-2.5 text-[12px] font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-50;
  }

  .btn-primary {
    @apply inline-flex h-8 items-center justify-center gap-1.5 rounded-md bg-blue-600 px-2.5 text-[12px] font-semibold text-white transition-colors hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50;
  }

  .btn-secondary {
    @apply inline-flex h-8 items-center justify-center gap-1.5 rounded-md border border-slate-300 bg-white px-2.5 text-[12px] font-semibold text-slate-700 transition-colors hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50;
  }

  .btn-danger {
    @apply inline-flex h-8 items-center justify-center gap-1.5 rounded-md bg-rose-600 px-2.5 text-[12px] font-semibold text-white transition-colors hover:bg-rose-700 disabled:cursor-not-allowed disabled:opacity-50;
  }

  .input {
    @apply h-8 w-full rounded-md border border-slate-300 bg-white px-2.5 text-[12px] text-slate-900 outline-none placeholder:text-slate-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500;
  }

  textarea.input {
    @apply h-auto min-h-[72px] py-2;
  }

  .label {
    @apply mb-1 block text-[11px] font-semibold text-slate-600;
  }

  .card {
    @apply rounded-lg border border-slate-200 bg-white shadow-none;
  }

  .badge {
    @apply inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold;
  }

  .page-header {
    @apply flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between;
  }

  .page-title {
    @apply text-[18px] font-semibold tracking-tight text-slate-900;
  }

  .page-subtitle {
    @apply mt-0.5 text-[11px] text-slate-500;
  }

  .page-actions {
    @apply flex flex-wrap items-center gap-1.5;
  }

  .table-shell {
    @apply overflow-hidden rounded-lg border border-slate-200 bg-white;
  }

  .data-table {
    @apply w-full border-collapse text-[11.5px];
  }

  .data-table th {
    @apply whitespace-nowrap border-b border-slate-200 bg-slate-50 px-2.5 py-2 text-left text-[10px] font-semibold uppercase tracking-wide text-slate-500;
  }

  .data-table td {
    @apply border-b border-slate-100 px-2.5 py-2 align-middle text-slate-700;
  }

  .data-table tbody tr:hover {
    @apply bg-slate-50;
  }

  .summary-card {
    @apply rounded-lg border border-slate-200 bg-white p-3 shadow-none;
  }

  .summary-label {
    @apply text-[10px] font-medium uppercase tracking-wide text-slate-500;
  }

  .summary-value {
    @apply mt-1 text-[17px] font-semibold tracking-tight text-slate-900;
  }

  .modal-panel {
    @apply w-full max-w-2xl overflow-hidden rounded-lg border border-slate-200 bg-white shadow-xl;
  }
}

