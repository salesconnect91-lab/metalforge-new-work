              <div className="divide-y divide-slate-200">
                <FinancialRow
                  label="Sales Value / فروخت"
                  value={metrics.salesTotal}
                  icon={<ShoppingCart className="h-4 w-4" />}
                />
                <FinancialRow
                  label="Purchase Value / خرید"
                  value={metrics.purchaseTotal}
